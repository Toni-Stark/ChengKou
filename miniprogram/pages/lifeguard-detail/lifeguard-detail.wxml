<view class="lifeguard-page">
  <!-- Banner -->
  <view class="page-banner" style="background: linear-gradient(135deg, #e53935, #c62828);">
    <text class="banner-icon">🛟</text>
    <text class="banner-title">救生员标准</text>
    <text class="banner-desc">安全第一 · 生命至上</text>
  </view>

  <!-- 考核标准 -->
  <view class="section-card">
    <view class="section-head">
      <text class="head-icon">✅</text>
      <text class="head-title">考核标准</text>
      <text class="head-count">{{standards.length}}项考核</text>
    </view>
    <view class="std-list">
      <view wx:for="{{standards}}" wx:key="label" class="std-item">
        <view class="std-icon-wrap" style="background: #ffebee;">
          <text class="std-icon">{{item.icon}}</text>
        </view>
        <view class="std-body">
          <view class="std-header">
            <text class="std-label">{{item.label}}</text>
            <text class="std-value">{{item.value}}</text>
          </view>
          <text class="std-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 等级划分 -->
  <view class="section-card">
    <view class="section-head">
      <text class="head-icon">⭐</text>
      <text class="head-title">救生员等级</text>
    </view>
    <view class="cat-list">
      <view wx:for="{{categories}}" wx:key="title" class="cat-item">
        <view class="cat-badge" style="background: {{item.color}};">
          <text>{{item.title}}</text>
        </view>
        <text class="cat-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>
</view>
