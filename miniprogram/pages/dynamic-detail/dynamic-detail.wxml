<view class="detail-page">
  <!-- 动态内容 -->
  <view class="post-section {{isOwner ? 'has-delete' : ''}}" wx:if="{{dynamic}}">
    <view class="post-header-bar" wx:if="{{isOwner}}">
      <view class="delete-btn" bindtap="onDeleteDynamic">
        <text class="delete-icon">🗑</text>
        <text>删除</text>
      </view>
    </view>
    <dynamic-item
      item="{{dynamic}}"
      isShow="{{isShow}}"
      youLongShow="{{youLongShow}}"
      bind:subscribe="onDynamicSubscribe"
      bind:comment="onComment"
      bind:share="onShare">
    </dynamic-item>
  </view>

  <!-- 评论区 -->
  <view class="comments-section">
    <view class="section-title">
      <text class="title-icon">💬</text>
      <text class="title-text">玛卡巴卡</text>
      <text class="title-count">{{dynamic.commentsCount || 0}}</text>
    </view>

    <view class="comments-list">
      <view
        class="comment-card"
        wx:for="{{commentsList}}"
        wx:key="_id">
        <view class="comment-top">
          <user-avatar src="{{item.userInfo.avatarUrl}}" size="medium"></user-avatar>
          <view class="comment-body">
            <view class="comment-meta">
              <text class="comment-author">{{item.userInfo.nickName}}</text>
              <text class="comment-time">{{item.displayTime || item.createTime}}</text>
            </view>
            <view class="comment-content">
              <text class="comment-text">{{item.content}}</text>
            </view>
            <view class="comment-reply-to" wx:if="{{item.replyToUser}}">
              <text class="reply-prefix">回复</text>
              <text class="reply-name">{{item.replyToUser.nickName}}</text>
            </view>
          </view>
          <view
            wx:if="{{isShow && youLongShow}}"
            class="like-btn {{item.isLiked ? 'liked' : ''}}"
            bindtap="onCommentLike"
            data-id="{{item._id}}"
            data-index="{{index}}">
            <text class="heart-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
            <text class="like-count" wx:if="{{item.likesCount > 0}}">{{item.likesCount}}</text>
          </view>
        </view>
      </view>

      <view class="comments-empty" wx:if="{{commentsList.length === 0 && !loading}}">
        <text class="empty-emoji">🐉</text>
        <text class="empty-title">还没有人说话</text>
        <text class="empty-sub">快来抢个沙发吧 ~</text>
      </view>
    </view>
  </view>
</view>

<!-- 评论输入栏 -->
<view wx:if="{{isShow && youLongShow}}" class="input-bar">
  <view class="input-row">
    <input
      class="input-pill"
      type="text"
      placeholder="和游龙们说点什么..."
      placeholder-class="text-placeholder"
      value="{{commentContent}}"
      bindinput="onCommentInput"
      confirm-type="send"
      bindconfirm="submitComment">
    </input>
    <button class="send-btn" bindtap="submitComment">叮一下</button>
  </view>
</view>
