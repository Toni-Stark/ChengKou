<view class="my-dynamics-page page">
  <!-- 发布按钮 -->
  <view wx:if="{{youLongShow}}" class="publish-btn" bindtap="goToPublish">
    <text class="publish-icon">+</text>
  </view>

  <!-- 游龙列表 -->
  <view class="dynamics-list" wx:if="{{!isEmpty}}">
    <!-- 初始加载态 -->
    <view class="loading-state" wx:if="{{loading && dynamicsList.length === 0}}">
      <text>加载中...</text>
    </view>

    <block wx:else>
    <view
      wx:for="{{dynamicsList}}"
      wx:key="_id"
      bindtap="onDynamicTap"
      data-id="{{item._id}}">
      <dynamic-item
        item="{{item}}"
        showEdit="{{true}}"
        isShow="{{isShow}}"
        youLongShow="{{youLongShow}}"
        bind:subscribe="onDynamicSubscribe"
        bind:comment="onDynamicComment"
        bind:edit="onEditDynamic">
      </dynamic-item>
    </view>

    <!-- 加载更多提示 -->
    <view class="load-more" wx:if="{{loading}}">
      <text class="text-secondary text-sm">加载中...</text>
    </view>

    <view class="load-more" wx:if="{{!hasMore && dynamicsList.length > 0}}">
      <text class="text-secondary text-sm">没有更多了</text>
    </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{isEmpty && !loading}}">
    <block wx:if="{{errorType === 'cloud'}}">
      <text class="empty-icon">⚠</text>
      <text class="empty-text text-secondary">云开发未配置，请检查环境</text>
      <button class="btn btn-primary mt-lg" bindtap="loadDynamics">重试</button>
    </block>
    <block wx:elif="{{errorType === 'network'}}">
      <text class="empty-icon">⚠</text>
      <text class="empty-text text-secondary">加载失败，请检查网络</text>
      <button class="btn btn-primary mt-lg" bindtap="loadDynamics">重试</button>
    </block>
    <block wx:else>
      <text class="empty-icon">📝</text>
      <text class="empty-text text-secondary">还没有发布游龙</text>
      <button wx:if="{{youLongShow}}" class="btn btn-primary mt-lg" bindtap="goToPublish">发布游龙</button>
    </block>
  </view>
</view>
