<view class="my-dynamics-page page">
  <!-- 发布按钮 -->
  <view wx:if="{{youLongShow}}" class="publish-btn" bindtap="goToPublish">
    <text class="publish-icon">+</text>
  </view>

  <!-- 游龙列表 -->
  <view class="dynamics-list" wx:if="{{!isEmpty}}">
    <view class="loading-state" wx:if="{{loading && dynamicsList.length === 0}}">
      <text>加载中...</text>
    </view>

    <block wx:else>
      <view
        wx:for="{{dynamicsList}}"
        wx:key="_id"
        bindtap="onDynamicTap"
        data-id="{{item._id}}">
        <dynamic-item
          item="{{item}}"
          showEdit="{{true}}"
          isShow="{{false}}"
          onList="{{true}}"
          youLongShow="{{youLongShow}}"
          bind:subscribe="onDynamicSubscribe"
          bind:comment="onDynamicComment"
          bind:edit="onEditDynamic">
        </dynamic-item>
      </view>

      <view class="load-more" wx:if="{{loading}}">
        <text>加载中...</text>
      </view>

      <view class="load-more" wx:if="{{!hasMore && dynamicsList.length > 0}}">
        <text>没有更多了</text>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{isEmpty && !loading}}">
    <block wx:if="{{errorType === 'cloud' || errorType === 'network'}}">
      <view class="empty-art">
        <view class="art-circle c1"></view>
        <view class="art-circle c2"></view>
        <view class="art-circle c3"></view>
        <text class="art-emoji">⚠</text>
      </view>
      <text class="empty-text">{{errorType === 'cloud' ? '云开发未配置，请检查环境' : '加载失败，请检查网络'}}</text>
      <view class="empty-btn" bindtap="loadDynamics">重试</view>
    </block>
    <block wx:else>
      <view class="empty-art">
        <view class="art-circle c1"></view>
        <view class="art-circle c2"></view>
        <view class="art-circle c3"></view>
        <text class="art-emoji">📝</text>
      </view>
      <text class="empty-text">还没有发布游龙</text>
      <view wx:if="{{youLongShow}}" class="empty-btn" bindtap="goToPublish">发布游龙</view>
    </block>
  </view>
</view>
