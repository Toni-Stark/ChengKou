<view class="my-likes-page">
  <!-- 顶部操作栏 -->
  <view class="top-bar" wx:if="{{subscriptionsList.length > 0}}">
    <view class="bar-info">
      <text class="bar-icon">⭐</text>
      <text class="bar-count">订阅了 {{subscriptionsList.length}} 位游龙</text>
    </view>
    <view class="bar-toggle" bindtap="toggleViewMode">
      <view class="toggle-bg {{viewMode === 'grid' ? 'grid' : 'list'}}"></view>
      <view class="toggle-opt {{viewMode === 'grid' ? 'active' : ''}}" data-mode="grid">▦</view>
      <view class="toggle-opt {{viewMode === 'list' ? 'active' : ''}}" data-mode="list">☰</view>
    </view>
  </view>

  <!-- 杂志网格视图 -->
  <view class="magazine-grid" wx:if="{{viewMode === 'grid' && !isEmpty}}">
    <view
      wx:for="{{subscriptionsList}}"
      wx:key="_openid"
      class="magazine-card {{index % 4 === 0 ? 'tall' : ''}} {{index % 3 === 0 ? 'wide' : ''}} {{index % 5 === 0 ? 'accent' : ''}}"
      style="animation-delay: {{index * 0.05}}s;"
      bindtap="onUserTap"
      data-openid="{{item._openid}}">
      <view class="magazine-bg" wx:if="{{item.avatarUrl}}">
        <image class="mag-bg-img" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view class="mag-bg-mask"></view>
      </view>
      <view class="magazine-body">
        <user-avatar src="{{item.avatarUrl}}" size="medium" shape="circle"></user-avatar>
        <text class="mag-name">{{item.nickName}}</text>
        <text class="mag-sig" wx:if="{{item.signature}}">{{item.signature}}</text>
      </view>
      <view class="magazine-actions">
        <view class="mag-unsub" catchtap="onUnsubscribe" data-openid="{{item._openid}}">
          <text>✕ 取消</text>
        </view>
      </view>
      <view class="magazine-shine"></view>
    </view>
  </view>

  <!-- 列表视图 -->
  <view class="subscription-list" wx:if="{{viewMode === 'list' && !isEmpty}}">
    <view
      wx:for="{{subscriptionsList}}"
      wx:key="_openid"
      class="list-card {{index % 2 === 0 ? 'card-even' : 'card-odd'}}"
      style="animation-delay: {{index * 0.04}}s;"
      bindtap="onUserTap"
      data-openid="{{item._openid}}">
      <view class="list-avatar-wrap">
        <user-avatar src="{{item.avatarUrl}}" size="medium"></user-avatar>
        <view class="list-avatar-ring {{index % 3 === 0 ? 'ring-purple' : index % 3 === 1 ? 'ring-gold' : 'ring-blue'}}"></view>
      </view>
      <view class="list-body">
        <text class="list-name">{{item.nickName}}</text>
        <text class="list-sig">{{item.signature || '这个人很懒，什么都没留下'}}</text>
      </view>
      <view class="list-status" wx:if="{{item.mutual}}">
        <text class="mutual-badge">🤝 互关</text>
      </view>
      <view class="list-action" catchtap="onUnsubscribe" data-openid="{{item._openid}}">
        <text class="list-unsub">取消订阅</text>
      </view>
    </view>

    <view class="load-more" wx:if="{{loading}}">
      <view class="dot-pulse">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
      <text class="load-text">加载中...</text>
    </view>

    <view class="load-more" wx:if="{{!hasMore && subscriptionsList.length > 0}}">
      <text class="load-text end-text">— 已经到底了 —</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-zone" wx:if="{{isEmpty && !loading}}">
    <view class="empty-bell">
      <view class="bell-ripple r1"></view>
      <view class="bell-ripple r2"></view>
      <view class="bell-ripple r3"></view>
      <text class="bell-icon">🔔</text>
    </view>
    <text class="empty-title">还没有订阅任何人</text>
    <text class="empty-desc">订阅你喜欢的游龙，第一时间收到他们的动态</text>
    <view class="empty-btn" bindtap="goToDynamics">
      <text class="empty-btn-icon">🧭</text>
      <text>去发现游龙</text>
    </view>
  </view>
</view>