<view class="my-likes-page page">
  <view class="likes-list" wx:if="{{!isEmpty}}">
    <view
      wx:for="{{subscriptionsList}}"
      wx:key="_openid"
      class="subscription-item card flex-row align-center">
      <user-avatar src="{{item.avatarUrl}}" size="medium"></user-avatar>
      <view class="flex-1 ml-base">
        <text class="text-base font-bold">{{item.nickName}}</text>
        <text class="text-xs text-secondary">{{item.signature || '这个人很懒，什么都没留下'}}</text>
      </view>
      <button
        class="btn-unsubscribe"
        size="mini"
        bindtap="onUnsubscribe"
        data-openid="{{item._openid}}">
        取消订阅
      </button>
    </view>

    <view class="load-more" wx:if="{{loading}}">
      <text class="text-secondary text-sm">加载中...</text>
    </view>

    <view class="load-more" wx:if="{{!hasMore && subscriptionsList.length > 0}}">
      <text class="text-secondary text-sm">没有更多了</text>
    </view>
  </view>

  <view class="empty-state" wx:if="{{isEmpty && !loading}}">
    <text class="empty-icon">🔔</text>
    <text class="empty-text text-secondary">还没有订阅任何人</text>
    <button class="btn btn-primary mt-lg" bindtap="goToDynamics">去看看</button>
  </view>
</view>
