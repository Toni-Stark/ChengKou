<view class="coach-page">
  <!-- Banner -->
  <view class="page-banner" style="background: linear-gradient(135deg, #ff9800, #f57c00);">
    <text class="banner-icon">🏅</text>
    <text class="banner-title">教练认证</text>
    <text class="banner-desc">专业资质 · 标准考核</text>
  </view>

  <!-- 认证条件 -->
  <view class="section-card">
    <view class="section-head">
      <text class="head-icon">✅</text>
      <text class="head-title">认证条件</text>
    </view>
    <view class="req-list">
      <view wx:for="{{requirements}}" wx:key="title" class="req-item">
        <text class="req-icon">{{item.icon}}</text>
        <view class="req-body">
          <text class="req-title">{{item.title}}</text>
          <text class="req-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 申请流程 -->
  <view class="section-card">
    <view class="section-head">
      <text class="head-icon">📋</text>
      <text class="head-title">申请流程</text>
    </view>
    <view class="process-list">
      <view wx:for="{{process}}" wx:key="step" class="process-item">
        <view class="process-num" style="background: #ff9800;">
          <text>{{item.step}}</text>
        </view>
        <view class="process-line" wx:if="{{index < process.length - 1}}"></view>
        <view class="process-body">
          <text class="process-title">{{item.title}}</text>
          <text class="process-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 联系方式 -->
  <view class="contact-bar">
    <text class="contact-text">{{contact}}</text>
  </view>
</view>
