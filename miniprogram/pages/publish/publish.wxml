<view class="publish-page" wx:if="{{youLongShow}}">
    <!-- 选择展示类型 -->
    <view class="section">
      <view class="section-title">选择展示方式</view>
      <radio-group bindchange="onDisplayTypeChange">
        <view class="display-type-list">
          <view class="display-type-item" wx:for="{{displayTypes}}" wx:key="value">
            <radio value="{{item.value}}" checked="{{displayType === item.value}}" color="#07c160"/>
            <view class="type-info">
              <text class="type-label">{{item.label}}</text>
              <text class="type-desc">{{item.desc}}</text>
            </view>
          </view>
        </view>
      </radio-group>
    </view>

    <!-- 视频模式 -->
    <view class="section" wx:if="{{displayType === 'video'}}">
      <view class="section-title">
        <text>视频 <text class="required">*</text></text>
      </view>
      <view class="video-upload-area" bindtap="chooseVideo" wx:if="{{!video}}">
        <text class="upload-icon">🎬</text>
        <text class="upload-text">点击选择视频</text>
        <text class="upload-tip">支持最长60秒</text>
      </view>
      <view class="video-preview-wrap" wx:if="{{video}}">
        <view class="video-player-box">
          <video
            class="video-player"
            src="{{video}}"
            controls
            show-center-play-btn
            object-fit="contain"
            binderror="onVideoError"
          ></video>
          <view class="video-progress-mask" wx:if="{{uploading && uploadFileIndex >= images.length}}">
            <view class="upload-spot-ring"></view>
            <text class="upload-spot-text">{{uploadProgress}}%</text>
          </view>
        </view>
        <view class="video-actions-row" wx:if="{{!uploading}}">
          <text class="video-file-name">已选择视频</text>
          <view class="video-action-right">
            <text class="video-action-link" bindtap="chooseVideo">重新选择</text>
            <text class="video-action-link" catchtap="deleteVideo">删除</text>
          </view>
        </view>
      </view>

      <view class="section-title mt-base">
        <text>描述</text>
        <text class="char-count">{{content.length}}/500</text>
      </view>
      <textarea class="textarea-field" placeholder="说说这个视频..." value="{{content}}" bindinput="onContentInput" maxlength="500" auto-height></textarea>
    </view>

    <!-- 大图模式 -->
    <view class="section" wx:if="{{displayType === 'large'}}">
      <view class="section-title">
        <text>标题 <text class="required">*</text></text>
        <text class="char-count">{{title.length}}/50</text>
      </view>
      <input class="input-field" type="text" placeholder="输入标题" value="{{title}}" bindinput="onTitleInput" maxlength="50" />

      <view class="section-title mt-base">
        <text>副标题</text>
        <text class="char-count">{{subtitle.length}}/100</text>
      </view>
      <input class="input-field" type="text" placeholder="输入副标题（可选）" value="{{subtitle}}" bindinput="onSubtitleInput" maxlength="100" />

      <view class="section-title mt-base">
        <text>封面图 <text class="required">*</text></text>
      </view>
      <view class="images-grid large-mode">
        <view class="image-wrapper" wx:if="{{images.length > 0}}">
          <image class="image-item" src="{{images[0]}}" mode="aspectFill"></image>
          <view class="delete-image-btn" bindtap="deleteImage" data-index="0" wx:if="{{!uploading}}">
            <text class="delete-icon">×</text>
          </view>
          <view class="upload-spot" wx:if="{{uploading && uploadFileIndex === 0}}">
            <view class="upload-spot-ring"></view>
            <text class="upload-spot-text">{{uploadProgress}}%</text>
          </view>
        </view>
        <view class="add-image-btn" bindtap="chooseImages" wx:if="{{images.length === 0}}">
          <text class="add-icon">+</text>
          <text class="add-text">添加封面</text>
        </view>
      </view>

      <view class="section-title mt-base">
        <text>详细描述</text>
        <text class="char-count">{{content.length}}/500</text>
      </view>
      <textarea class="textarea-field" placeholder="输入详细描述（可选）" value="{{content}}" bindinput="onContentInput" maxlength="500" auto-height></textarea>
    </view>

    <!-- 九宫格模式 -->
    <view class="section" wx:if="{{displayType === 'grid9'}}">
      <view class="section-title">
        <text>说点什么</text>
        <text class="char-count">{{content.length}}/500</text>
      </view>
      <textarea class="textarea-field" placeholder="分享新鲜事..." value="{{content}}" bindinput="onContentInput" maxlength="500" auto-height></textarea>

      <view class="section-title mt-base">
        <text>图片（最多9张）</text>
      </view>
      <view class="images-grid">
        <view class="image-wrapper" wx:for="{{images}}" wx:key="index">
          <image class="image-item" src="{{item}}" mode="aspectFill"></image>
          <view class="delete-image-btn" bindtap="deleteImage" data-index="{{index}}" wx:if="{{!uploading}}">
            <text class="delete-icon">×</text>
          </view>
          <view class="upload-spot" wx:if="{{uploading && uploadFileIndex === index}}">
            <view class="upload-spot-ring"></view>
            <text class="upload-spot-text">{{uploadProgress}}%</text>
          </view>
        </view>
        <view class="add-image-btn" bindtap="chooseImages" wx:if="{{images.length < 9}}">
          <text class="add-icon">+</text>
        </view>
      </view>
    </view>

    <!-- 纯文本模式 -->
    <view class="section" wx:if="{{displayType === 'text'}}">
      <view class="section-title">
        <text>文本内容 <text class="required">*</text></text>
        <text class="char-count">{{content.length}}/1000</text>
      </view>
      <textarea class="textarea-field large" placeholder="写下你的想法..." value="{{content}}" bindinput="onContentInput" maxlength="1000" auto-height></textarea>
    </view>

    <!-- 位置信息 -->
    <view class="section">
      <view class="location-section" wx:if="{{!location}}" bindtap="chooseLocation">
        <text class="location-icon">📍</text>
        <text class="location-text">添加位置</text>
      </view>
      <view class="location-section selected" wx:if="{{location}}">
        <text class="location-icon">📍</text>
        <text class="location-text">{{location.name}}</text>
        <text class="remove-location" bindtap="removeLocation">×</text>
      </view>
    </view>

    <view style="height: 120rpx;"></view>

  <!-- 发布按钮（固定底部） -->
  <view class="publish-bar">
    <button class="publish-btn" type="primary" disabled="{{submitting || uploading}}" bindtap="publish">
      {{uploading ? '上传中 ' + (uploadFileIndex + 1) + '/' + uploadTotalFiles : (submitting ? '发布中...' : '发布')}}
    </button>
  </view>
</view>
