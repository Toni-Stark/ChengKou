<view class="container">
  <view class="content-con">
    <scroll-view class="scroll" scroll-y>
      <!-- 选择展示类型 -->
      <view class="section">
        <view class="section-title">选择展示方式</view>
        <radio-group bindchange="onDisplayTypeChange">
          <view class="display-type-list">
            <view
              class="display-type-item"
              wx:for="{{displayTypes}}"
              wx:key="value">
              <radio value="{{item.value}}" checked="{{displayType === item.value}}" color="#07c160"/>
              <view class="type-info">
                <text class="type-label">{{item.label}}</text>
                <text class="type-desc">{{item.desc}}</text>
              </view>
            </view>
          </view>
        </radio-group>
      </view>

      <!-- 大图模式输入 -->
      <view class="section" wx:if="{{displayType === 'large'}}">
        <view class="section-title">
          <text>标题 <text class="required">*</text></text>
          <text class="char-count">{{title.length}}/50</text>
        </view>
        <input
          class="input-field"
          type="text"
          placeholder="输入标题"
          value="{{title}}"
          bindinput="onTitleInput"
          maxlength="50">
        </input>

        <view class="section-title mt-base">
          <text>副标题</text>
          <text class="char-count">{{subtitle.length}}/100</text>
        </view>
        <input
          class="input-field"
          type="text"
          placeholder="输入副标题（可选）"
          value="{{subtitle}}"
          bindinput="onSubtitleInput"
          maxlength="100">
        </input>

        <view class="section-title mt-base">
          <text>封面图 <text class="required">*</text></text>
        </view>
        <view class="images-grid large-mode">
          <view class="image-wrapper" wx:if="{{images.length > 0}}">
            <image class="image-item" src="{{images[0]}}" mode="aspectFill"></image>
            <view class="delete-image-btn" bindtap="deleteImage" data-index="0">
              <text class="delete-icon">×</text>
            </view>
          </view>
          <view class="add-image-btn" bindtap="chooseImages" wx:if="{{images.length === 0}}">
            <text class="add-icon">+</text>
            <text class="add-text">添加封面</text>
          </view>
        </view>

        <view class="section-title mt-base">
          <text>详细描述</text>
          <text class="char-count">{{content.length}}/500</text>
        </view>
        <textarea
          class="textarea-field"
          placeholder="输入详细描述（可选）"
          value="{{content}}"
          bindinput="onContentInput"
          maxlength="500"
          auto-height>
        </textarea>
      </view>

      <!-- 九宫格模式输入 -->
      <view class="section" wx:if="{{displayType === 'grid9'}}">
        <view class="section-title">
          <text>说点什么</text>
          <text class="char-count">{{content.length}}/500</text>
        </view>
        <textarea
          class="textarea-field"
          placeholder="分享新鲜事..."
          value="{{content}}"
          bindinput="onContentInput"
          maxlength="500"
          auto-height>
        </textarea>

        <view class="section-title mt-base">
          <text>图片（最多9张）</text>
        </view>
        <view class="images-grid">
          <view
            class="image-wrapper"
            wx:for="{{images}}"
            wx:key="index">
            <image class="image-item" src="{{item}}" mode="aspectFill"></image>
            <view class="delete-image-btn" bindtap="deleteImage" data-index="{{index}}">
              <text class="delete-icon">×</text>
            </view>
          </view>
          <view class="add-image-btn" bindtap="chooseImages" wx:if="{{images.length < 9}}">
            <text class="add-icon">+</text>
          </view>
        </view>
      </view>

      <!-- 纯文本模式输入 -->
      <view class="section" wx:if="{{displayType === 'text'}}">
        <view class="section-title">
          <text>文本内容 <text class="required">*</text></text>
          <text class="char-count">{{content.length}}/1000</text>
        </view>
        <textarea
          class="textarea-field large"
          placeholder="写下你的想法..."
          value="{{content}}"
          bindinput="onContentInput"
          maxlength="1000"
          auto-height>
        </textarea>
      </view>

      <!-- 位置信息 -->
      <view class="section">
        <view class="location-section" wx:if="{{!location}}" bindtap="chooseLocation">
          <text class="location-icon">📍</text>
          <text class="location-text">添加位置</text>
        </view>
        <view class="location-section selected" wx:if="{{location}}">
          <text class="location-icon">📍</text>
          <text class="location-text">{{location.name}}</text>
          <text class="remove-location" bindtap="removeLocation">×</text>
        </view>
      </view>
    </scroll-view>
  </view>
  <view class="publish-section">
    <button
      class="publish-btn"
      type="primary"
      disabled="{{submitting}}"
      bindtap="publish">
      {{submitting ? '发布中...' : '发布'}}
    <view style="width: 100%; background: #d1d1d1; height: 100px"></view></button>
  </view>
</view>
<!-- 发布按钮 -->