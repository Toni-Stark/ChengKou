<view class="settings-page page">
  <view class="container">
    <!-- 账号信息 -->
    <view class="section">
      <text class="section-title">账号信息</text>
      <view class="menu-list">
        <view class="menu-item" bindtap="editProfile">
          <text class="menu-label">编辑资料</text>
          <text class="menu-arrow">→</text>
        </view>
      </view>
    </view>

    <!-- 数据管理 -->
    <view class="section">
      <text class="section-title">数据管理</text>
      <view class="menu-list">
        <view class="menu-item" bindtap="clearCache">
          <text class="menu-label">清除缓存</text>
          <view class="menu-right">
            <text class="cache-size text-secondary">{{cacheSize}}</text>
            <text class="menu-arrow">→</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 关于 -->
    <view class="section">
      <text class="section-title">关于</text>
      <view class="menu-list">
        <view class="menu-item" bindtap="showAbout">
          <text class="menu-label">关于我们</text>
          <text class="menu-arrow">→</text>
        </view>
        <view class="menu-item" bindtap="showVersion">
          <text class="menu-label">当前版本</text>
          <view class="menu-right">
            <text class="version-text text-secondary">{{version}}</text>
            <text class="menu-arrow">→</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 退出登录按钮 -->
    <button class="logout-btn" bindtap="logout" wx:if="{{isLogin}}">退出登录</button>
  </view>
</view>
