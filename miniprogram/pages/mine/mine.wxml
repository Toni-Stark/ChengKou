<view class="mine-page page">
  <view class="header-status-bar" style="height:{{height}}px"></view>
  <!-- 用户信息卡片 -->
  <view class="user-card bg-white">
    <view class="user-header flex-row align-center">
      <user-avatar src="{{userInfo.avatarUrl}}" size="large"></user-avatar>
      <view class="user-info flex-1 flex-column ml-lg">
        <text class="user-name font-bold">{{userInfo.nickName}}</text>
        <text class="user-signature text-sm text-secondary">{{userInfo.signature || '这个人很懒，什么都没留下'}}</text>
      </view>
    </view>

    <view class="user-stats flex-between mt-lg">
      <view class="stat-item text-center">
        <text class="stat-value font-bold">{{userInfo.stats.dynamicsCount || 0}}</text>
        <text class="stat-label text-xs text-secondary">游龙</text>
      </view>
      <view class="stat-item text-center">
        <text class="stat-value font-bold">{{userInfo.stats.followersCount || 0}}</text>
        <text class="stat-label text-xs text-secondary">粉丝</text>
      </view>
      <view class="stat-item text-center">
        <text class="stat-value font-bold">{{userInfo.stats.subscriptionsCount || 0}}</text>
        <text class="stat-label text-xs text-secondary">订阅</text>
      </view>
    </view>

    <view class="user-actions flex-row mt-lg">
      <button wx:if="{{!userInfo._openid}}" class="btn btn-primary btn-block" bindtap="goToLogin">立即登录</button>
      <block wx:else>
        <button class="btn btn-primary flex-1 mr-sm" bindtap="editProfile">编辑资料</button>
        <button class="btn btn-success" bindtap="goToSwimRecords">今日打卡</button>
      </block>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-list container mt-base">
    <view class="menu-item card flex-between align-center" bindtap="goToMyDynamics">
      <text class="menu-title">我的游龙</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item card flex-between align-center" bindtap="goToMySubscriptions">
      <text class="menu-title">管理订阅</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item card flex-between align-center" bindtap="goToSettings">
      <text class="menu-title">设置</text>
      <text class="menu-arrow">→</text>
    </view>
  </view>
</view>
